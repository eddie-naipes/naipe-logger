{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "allowJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Para o tsc, @wailsjs aponta para a cópia corrigida dos tipos gerados
    // (scripts/wails-types.mjs); em tempo de execução o Vite resolve o mesmo
    // alias para wailsjs/.
    "paths": {
      "@wailsjs/*": ["./.wails-types/*"]
    }
  },
  "include": ["src"]
}
